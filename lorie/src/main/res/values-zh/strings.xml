    <string name="lorie_pref_touchMode">触控屏输入模式</string>
    <string name="lorie_pref_scaleTouchpad">将显示缩放系数应用到触控板</string>
    <string name="lorie_pref_showStylusClickOverride">显示手写笔点击选项</string>
    <string name="lorie_pref_showStylusClickOverride_summary">手写笔触控覆盖：左键、中键或右键点击（仅限手写笔）</string>
    <string name="lorie_pref_stylusIsMouse">启用手写笔鼠标仿真模式</string>
    <string name="lorie_pref_stylusIsMouse_summary">让手写笔表现得像普通鼠标。启用后，手写笔仅移动光标并发送鼠标点击，忽略压力、倾斜与按压角度。</string>
    <string name="lorie_pref_stylusButtonContactModifierMode">手写笔按键触控修饰模式</string>
    <string name="lorie_pref_stylusButtonContactModifierMode_summary">启用后，仅在按住笔身按键且笔尖接触屏幕时才发送鼠标右键或中键点击。</string>
    <string name="lorie_pref_showMouseHelper">显示鼠标辅助按键悬浮窗</string>
    <string name="lorie_pref_showMouseHelper_summary">在屏幕上提供可在触控板模式下使用的左中右鼠标软按键</string>
    <string name="lorie_pref_pointerCapture">优先独占捕获外接鼠标/指针设备</string>
    <string name="lorie_pref_pointerCapture_summary">拦截所有硬件鼠标/触控板事件。按下 Esc 键即可将指针释放回 Android 系统。</string>
    <string name="lorie_pref_transformCapturedPointer">转换捕获的鼠标指针移动方向</string>
    <string name="lorie_pref_capturedPointerSpeedFactor">捕获指针移动速度比例 (%)</string>
    <string name="lorie_pref_tapToMove">启用触控板轻触移动</string>
    <string name="lorie_pref_ignoreGamepadEvents">忽略游戏手柄输入事件</string>
    <string name="lorie_pref_ignoreGamepadEvents_summary">禁止将游戏手柄和摇杆事件转发给 X11 服务器</string>
    <string name="lorie_pref_zoomFollowsCursor">画面放大时自动跟随鼠标光标平移</string>

    <string name="lorie_pref_showAdditionalKbd">显示附加按键栏</string>
    <string name="lorie_pref_showAdditionalKbd_summary">在屏幕上方或下方显示 Esc/Ctrl/Alt 等特殊按键栏</string>
    <string name="lorie_pref_showIMEWhileExternalConnected">连接外接键盘时依然显示软键盘</string>
    <string name="lorie_pref_showIMEWhileExternalConnected_summary">当接入蓝牙或 USB 硬件物理键盘时，仍允许调出手机屏幕软键盘。</string>
    <string name="lorie_pref_preferScancodes">优先使用物理扫描码 (Scancodes)</string>
    <string name="lorie_pref_preferScancodes_summary">允许 X11 服务器与桌面环境（或 setxkbmap）直接管理硬件键盘布局。</string>
    <string name="lorie_pref_hardwareKbdScancodesWorkaround">硬件键盘扫描码兼容模式</string>
    <string name="lorie_pref_hardwareKbdScancodesWorkaround_summary">修复部分安卓设备物理键盘的键码映射异常问题（可能会影响多语言布局切换）。</string>
    <string name="lorie_pref_dexMetaKeyCapture">拦截系统级快捷键</string>
    <string name="lorie_pref_dexMetaKeyCapture_summary">仅限三星 DeX 模式。允许拦截并传递 Alt+F4、Win+D、Win+E 等快捷键至 Linux 系统。</string>
    <string name="lorie_pref_enableAccessibilityService">手动开启无障碍服务以拦截系统按键</string>
    <string name="lorie_pref_enableAccessibilityService_summary">打开系统的无障碍设置页面。</string>
    <string name="lorie_pref_enableAccessibilityServiceAutomatically">自动开启无障碍快捷键拦截服务</string>
    <string name="lorie_pref_enableAccessibilityServiceAutomatically_summary">需要通过 adb 赋予 WRITE_SECURE_SETTINGS 系统权限。</string>
    <string name="lorie_pref_pauseKeyInterceptingWithEsc">按 Esc 键暂停按键拦截</string>
    <string name="lorie_pref_filterOutWinkey">过滤被拦截的 Win (Meta/Mod4) 键</string>
    <string name="lorie_pref_filterOutWinkey_summary">允许在拦截按键的同时正常使用 DeX 自身的系统快捷键。需要无障碍服务开启。</string>
    <string name="lorie_pref_enforceCharBasedInput">强制基于字符的文本输入</string>
    <string name="lorie_pref_enforceCharBasedInput_summary">禁止输入法联想、预测文本与 CJK 输入法弹出冲突</string>

